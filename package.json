{
  "name": "@hiruge/asc-mcp",
  "version": "1.1.0",
  "description": "Unofficial MCP server for the App Store Connect API: releases, App Review, TestFlight, in-app purchases, screenshots, and ASO analysis",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "asc-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hiru-ge/asc-mcp.git"
  },
  "homepage": "https://github.com/Hiru-ge/asc-mcp#readme",
  "bugs": {
    "url": "https://github.com/Hiru-ge/asc-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "app-store-connect",
    "app-store",
    "ios",
    "aso",
    "testflight",
    "claude-code",
    "claude"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jose": "^6.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
